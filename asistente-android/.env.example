# --- Asistente ---------------------------------------------------------------
# Clave de la API de Anthropic. Sin ella la app sigue funcionando: crea tareas y
# lista pendientes con el intérprete de fechas local, pero no conversa.
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto, claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Zona horaria ------------------------------------------------------------
# Zona con la que se interpretan "mañana a las 3" y se muestran los avisos.
# TZ_USUARIO=America/Bogota

# --- Notificaciones push -----------------------------------------------------
# Claves VAPID para que los recordatorios lleguen con la app cerrada.
# Genéralas con:  node pruebas/generar-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --- Recordatorios -----------------------------------------------------------
# Cada cuánto barre el servidor los recordatorios vencidos, en milisegundos.
# Pon 0 para desactivar el barrido interno y usar solo el cron externo.
# INTERVALO_RECORDATORIOS_MS=30000

# Si lo defines, POST /api/recordatorios/tick exige
# `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=

# --- Almacenamiento ----------------------------------------------------------
# Carpeta donde se guarda db.json (hilo, tareas y suscripciones push).
# DATA_DIR=./data
