# --- Asistente ---------------------------------------------------------------
# Clave de la API de Anthropic. Sin ella la app sigue funcionando: crea tareas y
# lista pendientes con el intérprete de fechas local, pero no conversa.
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto, claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Zona horaria ------------------------------------------------------------
# Zona con la que se interpretan "mañana a las 3" y se muestran los avisos.
# TZ_USUARIO=America/Bogota

# --- Notificaciones push -----------------------------------------------------
# Claves VAPID para que los recordatorios lleguen con la app cerrada.
# Genéralas con:  node pruebas/generar-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --- Recordatorios -----------------------------------------------------------
# Cada cuánto barre el servidor los recordatorios vencidos, en milisegundos.
# Pon 0 para desactivar el barrido interno y usar solo el cron externo.
# INTERVALO_RECORDATORIOS_MS=30000

# Si lo defines, POST /api/recordatorios/tick exige
# `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=

# --- Telegram (el canal del celular) -----------------------------------------
# Token del bot. Se pide a @BotFather en Telegram con /newbot.
TELEGRAM_BOT_TOKEN=

# Chats autorizados, separados por comas. SIN ESTO EL BOT NO ATIENDE A NADIE:
# un bot de Telegram es público y cualquiera que dé con él vería tus tareas.
# Para saber tu id: arranca el bot, escríbele /chatid, o usa
#   npm run telegram -- escuchar
TELEGRAM_CHATS_PERMITIDOS=

# sondeo  → el servidor pregunta a Telegram (no necesita URL pública). Por defecto.
# webhook → Telegram llama a tu servidor. Necesita HTTPS público; obligatorio en serverless.
# TELEGRAM_MODO=sondeo

# Solo en modo webhook: secreto que Telegram manda en cada llamada. Sin él, la
# URL queda abierta a que cualquiera inyecte mensajes falsos.
# TELEGRAM_WEBHOOK_SECRET=

# Segundos que espera cada sondeo largo.
# TELEGRAM_SONDEO_SEGUNDOS=25

# --- Almacenamiento ----------------------------------------------------------
# Carpeta donde se guarda db.json (hilo, tareas y suscripciones push).
# DATA_DIR=./data
